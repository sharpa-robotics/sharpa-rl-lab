                double3 target = (0.01387723743075192, -0.024432111538560175, 0.057954679301273515)
            }
            dictionary Right = {
                double3 position = (0, -5, 0)
                double radius = 5
            }
            dictionary Top = {
                double3 position = (0, 0, 5)
                double radius = 5
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary metricsAssembler = {
            dictionary "/right_hand_calibration_tool_simplified" = {
            }
